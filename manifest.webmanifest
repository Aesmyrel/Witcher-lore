{
  "id": "./",
  "name": "Compagnon du Sorceleur",
  "short_name": "Sorceleur",
  "description": "Le lore des livres de Sapkowski au rythme de votre partie de The Witcher 3 : codex sans spoilers, carte, bestiaire et défis entre amis.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2b2017",
  "theme_color": "#2b2017",
  "categories": [
    "books",
    "games",
    "entertainment"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien"
    }
  },
